{
  "name": "memorization-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/entradas/local.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/construir.mjs",
    "build:local": "node scripts/construir.mjs --banco=sqlite",
    "build:cloud": "node scripts/construir.mjs --banco=postgresql",
    "build:lambda": "node scripts/construir.mjs --banco=lambda",
    "start:local": "node dist/sqlite/servidor.mjs",
    "start:cloud": "node dist/postgresql/servidor.mjs",
    "migrate:cloud": "node dist/postgresql/migrar.mjs",
    "test": "npm run test:geral && npm run test:postgresql",
    "test:geral": "vitest run",
    "test:postgresql": "vitest run --config vitest.postgresql.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.1",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "pg": "^8.23.0",
    "sql.js": "^1.14.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1136.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.5"
  }
}
