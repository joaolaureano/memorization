{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegraDeLimpeza",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DescribeRule",
        "events:DeleteRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:ListTargetsByRule",
        "events:ListTagsForResource",
        "events:TagResource",
        "events:UntagResource"
      ],
      "Resource": "arn:aws:events:us-east-1:019593222321:rule/memorization-limpeza-contas-de-teste"
    },
    {
      "Sid": "PermissaoDaFuncaoParaRegra",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy"
      ],
      "Resource": "arn:aws:lambda:us-east-1:019593222321:function:memorization-api"
    }
  ]
}
